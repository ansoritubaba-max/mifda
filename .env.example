# ============================================================
# .env TEMPLATE — APLIKASI BELAJAR MI
# Salin file ini menjadi .env, lalu isi nilai-nilainya
# JANGAN pernah commit .env asli ke git atau distribusi!
# ============================================================
APP_NAME="Belajar MI"
APP_ENV=production
APP_KEY=                   # generate: php artisan key:generate
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barmi
DB_USERNAME=root
DB_PASSWORD=

# AI Gemini (model: gemini-1.5-flash-8b - hemat limit)
GEMINI_API_KEY=            # https://aistudio.google.com/apikey

# Notifikasi WhatsApp via Fonnte
FONNTE_TOKEN=              # https://fonnte.com

FILESYSTEM_DISK=public
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="noreply@belajarmi.id"
MAIL_FROM_NAME="${APP_NAME}"

# Integrasi Absensi <-> Mifda — isi dengan token yang sama persis dengan
# .env aplikasi Absensi.
INTEGRATION_API_TOKEN=
ABSENSI_API_BASE_URL=
